{
  "name": "legacy-exodus-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "legacy-exodus": "src/cli/index.ts"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "dev": "bun --watch run src/cli/index.ts",
    "legacy-exodus": "bun run src/cli/index.ts",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "benchmark": "bun run benchmarks/cli.ts",
    "verify": "bun run src/cli/index.ts verify"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "commander": "^15.0.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.6.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
